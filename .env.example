# Database (separate from CRM)
MARKETPLACE_DATABASE_URL=postgresql://user:password@localhost:5432/aqar_marketplace

# Redis
REDIS_URL=redis://localhost:6379

# CRM Bridge
CRM_BASE_URL=http://localhost:3001
MARKETPLACE_SECRET=generate_64_char_random_secret_here

# NextAuth.js v5
NEXTAUTH_SECRET=generate_32_char_random_secret_here
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=from_google_cloud_console
GOOGLE_CLIENT_SECRET=from_google_cloud_console
APPLE_CLIENT_ID=from_apple_developer
APPLE_CLIENT_SECRET=from_apple_developer

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token

# WhatsApp (for OTP + Inquiry Shield)
WHATSAPP_PROVIDER=ULTRAMSG
ULTRAMSG_INSTANCE_ID=your_instance_id
ULTRAMSG_TOKEN=your_token
PLATFORM_WHATSAPP_NUMBER=+201000000000

# Push Notifications
VAPID_PUBLIC_KEY=generate_with_web-push_generateVAPIDKeys
VAPID_PRIVATE_KEY=generate_with_web-push_generateVAPIDKeys
VAPID_EMAIL=mailto:push@yourdomain.com
